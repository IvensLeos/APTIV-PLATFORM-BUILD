{
	"name": "aptiv-platform",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 FORCE_PROD=false vite dev --host 0.0.0.0 --port 80",
		"dev-aptiv": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 FORCE_PROD=true vite dev --host 0.0.0.0 --port 80",
		"build": "vite build",
		"build-aptiv": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 FORCE_PROD=true vite build",
		"preview": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 vite preview --port 80",
		"preview-aptiv": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 FORCE_PROD=true ORIGIN=http://dlhs372n3.aptiv.com vite preview --host 0.0.0.0 --port 80 --strictPort",
		"start": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 FORCE_PROD=true HOST=0.0.0.0 PORT=80 ORIGIN=http://dlhs372n3.aptiv.com node build",
		"prepare": "playwright install && svelte-kit sync || echo ''",
		"lint": "prettier --check . && eslint .",
		"test:e2e": "playwright test",
		"test": "npm run test:e2e",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/cheerio": "^0.22.35",
		"@types/node": "^24",
		"autoprefixer": "^10.5.0",
		"cross-env": "^10.1.0",
		"eslint": "^10.2.0",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"postcss": "^8.5.12",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"tailwindcss": "^4.2.4",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"chart.js": "^4.5.1",
		"chartjs-plugin-annotation": "^3.1.0",
		"chartjs-plugin-datalabels": "^2.2.0",
		"cheerio": "^1.2.0",
		"cheerio-tableparser": "^1.0.1",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.7",
		"mongodb": "^7.2.0",
		"node-cron": "^4.2.1",
		"qrcode": "^1.5.4",
		"xlsx": "^0.18.5"
	}
}
